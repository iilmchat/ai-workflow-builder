    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "bullmq": "^6.3.12",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
