# Production-окружение backend'а (v1.6.0 S6-C).
#
# Как использовать (деплой на VPS):
#   1. скопировать этот файл в `.env` рядом с `docker-compose.prod.yml`:
#        cp .env.production.example .env
#   2. заменить ВСЕ заглушки `<...>` реальными значениями (RULES 5.1: секреты
#      живут только в `.env` на хосте, в git их нет);
#   3. `docker compose -f docker-compose.prod.yml -f docker-compose.prod.override.yml up -d`.
#
# Файл коммитится: секретов в нём нет, только заглушки. Реальный `.env`
# покрыт `.gitignore`.
#
# `NODE_ENV=production` включает fail-fast проверки `src/config/env.schema.ts`:
# `COOKIE_SECURE=false`, `AUTH_DISABLED=true` и пустой `CORS_ALLOWED_ORIGINS`
# роняют старт — это защита, а не повод ослабить значение.

NODE_ENV=production
PORT=3000

# Backend стоит за Caddy: `TRUST_PROXY=true` обязателен, иначе `req.ip` — это
# IP контейнера Caddy, и rate limit (`ThrottlerGuard`) считает один общий
# лимит на всех клиентов (KI-419). Строгий boolean: `1`/`yes` не принимаются
# (RULES 4.35), поэтому именно `true`.
TRUST_PROXY=true

# Refresh-cookie: только по HTTPS (Caddy терминирует TLS).
COOKIE_SECURE=true

# SameSite refresh-cookie по умолчанию (Strict | Lax | None).
# В вебе оставить Strict. Для Android/Capacitor: COOKIE_SAMESITE=None
# (запросы с Origin capacitor://localhost / https://localhost в production
# получают SameSite=None; Secure автоматически, S6-B/KI-664).
COOKIE_SAMESITE=Strict

# Allowlist origin'ов CORS. ОБЯЗАТЕЛЕН при NODE_ENV=production.
# Домен прода — `https://ai-workflow-builder.ru`; `https://localhost` и
# `capacitor://localhost` нужны release-сборке Android/iOS (KI-658).
CORS_ALLOWED_ORIGINS=https://ai-workflow-builder.ru,https://localhost,capacitor://localhost

# Внутри compose-сети: имена сервисов `db`/`redis`, не 127.0.0.1 (RULES 4.31).
# ВНИМАНИЕ: `docker-compose.prod.yml` пересобирает DATABASE_URL из
# POSTGRES_* и перекрывает эту строку; здесь она — для запуска образа без
# compose (например, `docker run --env-file .env`).
DATABASE_URL=postgres://workflow_builder:<password>@db:5432/workflow_builder
REDIS_URL=redis://redis:6379

# --- PostgreSQL (используется контейнером db) ---
# Пароль должен совпадать с `<password>` в DATABASE_URL.
POSTGRES_USER=workflow_builder
POSTGRES_PASSWORD=<password>
POSTGRES_DB=workflow_builder

# --- Медиа: Selectel S3 (v1.6.0 S6-C) ---
# Selectel не отдаёт CORS для path-style URL, поэтому S3_FORCE_PATH_STYLE=false
# (virtual-hosted `https://wf-media-iilmchat.s3.ru-7.storage.selcloud.ru/<key>`).
# Бакет приватный: приложение отдаёт presigned GET (`S3_PUBLIC_BUCKET=false`).
MEDIA_STORAGE_BACKEND=s3
S3_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
S3_BUCKET=wf-media-iilmchat
S3_REGION=ru-7
S3_ACCESS_KEY_ID=<key>
S3_SECRET_ACCESS_KEY=<secret>
S3_PUBLIC_BUCKET=false
S3_FORCE_PATH_STYLE=false
# Локальный бэкенд оставлен как аварийный откат (volume, TTL 90 дней).
# MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_LOCAL_TTL_DAYS=90

# Идентификатор инстанса: маркер в payload заданий BullMQ (KI-387/KI-391).
# В Docker hostname эфемерный — задавать явно.
INSTANCE_ID=wf-prod-01

# Трассировка выключена, пока нет OTLP-коллектора: SDK держит фоновый
# экспортёр и подменяет глобальный провайдер (R7.7, KI-365).
OTEL_ENABLED=false

# WASM-песочница condition `mode: sandbox`: на боевом сервере включаем осознанно.
SANDBOX_ENABLED=true

# Секрет подписи JWT, минимум 32 символа (`openssl rand -hex 32`).
JWT_SECRET=<min-32-chars>

# Allowlist `GET /metrics` (S6-A): точные адреса и IPv4-CIDR.
# `127.0.0.1`/`::1` — scrape с самого хоста; `172.18.0.0/16` — подсеть compose
# (проверить: `docker network inspect`); `62.109.1.230` — внешний скрейпер.
METRICS_ALLOWED_IPS=127.0.0.1,::1,172.18.0.0/16,62.109.1.230

# Режим регистрации (S6-C): open | invite. На проде сейчас open + fail2ban;
# invite — только по ожидающему приглашению в organization_invitations.
REGISTRATION_MODE=open

# Аварийный облачный LLM-fallback (S6-C): none | deepseek | yandex | openai.
# Прод работает на локальном LM Studio через reverse-SSH; при его падении
# вызов уйдёт в облако, если задан провайдер и ключ. Без ключа — WARN и пропуск.
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_API_KEY=
