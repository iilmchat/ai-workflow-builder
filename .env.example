# === Database ===
# Docker compose maps 5433 -> 5432 (avoid Windows PostgreSQL on 5432)
DATABASE_URL=postgres://workflow:devpass123@127.0.0.1:5433/workflow_builder

# === App ===
NODE_ENV=development
PORT=3000
# Доверять X-Forwarded-For от reverse proxy (nginx/Caddy). Включать ТОЛЬКО
# когда backend стоит за прокси: иначе ThrottlerGuard видит IP прокси и
# считает общий лимит 5/мин на всех клиентов (KI-419). При прямом доступе
# клиент подделает заголовок и обойдёт rate limiting — оставлять false.
TRUST_PROXY=false

# === CORS (v1.6.0 S6-A) ===
# В dev CORS отражает Origin запроса (origin: true) — так работают Vite-прокси
# и Capacitor WebView. В production (NODE_ENV=production) allowlist обязателен:
# приложение НЕ стартует с пустым значением, чтобы не открыть API всему
# интернету. Формат — через запятую, без пробелов; схемы https/http/capacitor.
# Для prod: https://app.<домен>,https://localhost,capacitor://localhost
CORS_ALLOWED_ORIGINS=

# === LLM Providers (R3, мультипровайдерность — v0.5.0) ===
# Провайдер попадает в GET /llm/models только если задан его ключ
# (исключение — LM Studio: там нужен непустой LMSTUDIO_MODELS).
# Пустое значение = «провайдер не сконфигурирован» (KI-084).

# === Anthropic ===
ANTHROPIC_API_KEY=

# === OpenAI ===
OPENAI_API_KEY=
# Base URL (опционально; по умолчанию https://api.openai.com/v1)
OPENAI_BASE_URL=

# === RouterAI (OpenAI-совместимый прокси к 100+ моделям) ===
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# === GPTunnel (OpenAI-совместимый chat) ===
# Base URL и ключ — из личного кабинета https://gptunnel.ru
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
# Список моделей для UI (id:modality+modality[:reasoning],id:modality).
# Полный список: GET {GPTUNNEL_BASE_URL}/models
# Суффикс `:reasoning` помечает модель как поддерживающую reasoning:
# ей ставится defaultMaxTokens=4096 (обычным — 1024, KI-183).
# Пример (замени на свои):
#   claude-5.5-sonnet:text+vision,claude-opus-5.5:text+vision,
#   gpt-5.6-luna:text,gemini-3.8-flash:text+vision,
#   deepseek-v4-flash:text:reasoning,grok-4.7:text+vision,qwen3.8-max:text,
#   glm-5.3-flash:text
GPTUNNEL_MODELS=

# === GPTunnel CreativeLab (media — IMAGE/VIDEO/AUDIO/MUSIC/3D) ===
# Ключ из личного кабинета https://gptunnel.ru (можно тот же, что для chat).
GPTUNNEL_MEDIA_API_KEY=
GPTUNNEL_MEDIA_BASE_URL=https://gptunnel.ru/api/v2/media
# TTL кэша списка моделей (мс). Default 900000 (15 минут).
GPTUNNEL_MEDIA_CACHE_TTL_MS=900000
# Лимит ожидания media-задачи генерации (мс), R7.2: video/audio/music
# генерируются минутами. Default 600000 (10 минут). Должен быть больше
# WORKFLOW_RUNS_LOCK_DURATION_MS, иначе BullMQ переотдаст job во время ожидания.
CREATIVELAB_MEDIA_TIMEOUT_MS=600000

# === Прямые image-провайдеры (R7.3, DESIGN v0.9 § 3.3) ===
# Провайдер регистрируется только при заданном ключе; без ключа его модели
# не попадают в GET /media/models, а приложение поднимается как обычно.
# Пустое значение = «не сконфигурирован» (KI-084).

# --- Replicate (100+ моделей: flux, SDXL, Kling, ...; API в долларах) ---
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com/v1

# --- FAL (быстрый inference: fal-ai/flux/schnell, fal-ai/kling-video, ...) ---
FAL_KEY=
# Дефолт fal.run — синхронный вызов; для очереди укажите https://queue.fal.run.
FAL_BASE_URL=https://fal.run

# --- OpenAI Images (gpt-image-1, dall-e-3) ---
# Можно оставить пустым — ключ возьмётся из OPENAI_API_KEY (fallback).
OPENAI_IMAGES_API_KEY=
OPENAI_IMAGES_BASE_URL=https://api.openai.com/v1

# Порядок провайдеров при коллизии id модели (первый побеждает).
MEDIA_PROVIDER_PRIORITY=creativelab,replicate,fal,openai_images
# Курс USD→RUB для оценки стоимости моделей Replicate/FAL (бюджет R7.1 в рублях).
MEDIA_USD_RUB_RATE=100

# === DeepSeek (OpenAI-совместимый) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# === Yandex AI Studio (OpenAI-совместимый) ===
YANDEX_API_KEY=
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
# id каталога Yandex Cloud. Нужен для коротких id в YANDEX_MODELS и для
# дефолтного списка моделей (KI-159, KI-174).
YANDEX_FOLDER_ID=
# Формат: <id>:<модальности>,<id>:<модальности>. id — короткое имя
# (yandexgpt-lite) или полный gpt://<folder>/<model>/<version>.
# Без суффикса модель считается текстовой; модальности — через +.
# Пример: gpt://b1gufspraeh2i5nin6nt/yandexgpt-lite/latest:text,gpt://b1gufspraeh2i5nin6nt/qwen3.6-35b-a3b/latest:text+vision
# Пусто — дефолт yandexgpt-lite/latest + yandexgpt/latest (нужен YANDEX_FOLDER_ID).
YANDEX_MODELS=

# === LM Studio (локальный сервер, ключ не нужен) ===
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Список моделей через запятую с модальностями: <id>[:модальность[+модальность]].
# id должны совпадать с тем, что отдаёт `GET /v1/models` у LM Studio —
# обычно с префиксом издателя, напр. qwen/qwen2.5-coder-7b-instruct (KI-156).
# Посмотреть свои id: curl http://localhost:1234/v1/models
LMSTUDIO_MODELS=qwen/qwen2.5-coder-7b-instruct:text,qwen/qwen2.5-vl-7b:text+vision

# === LLM Router (v1.2 S1: локальный GPU → облачный fallback) ===
# false — прежнее поведение: провайдер выбирается по id модели из узла.
# true  — при наличии LM Studio вызов сначала идёт в него, а при ошибке
#         (сервер выключен, 5xx, таймаут, пустой ответ) повторяется в облако.
# Healthcheck пингует LM Studio раз в 30 с; после 3 неудач подряд локальный
# провайдер исключается из роутинга до восстановления.
LLM_ROUTER_ENABLED=false
# Модель облачного fallback; должна быть объявлена настроенным провайдером.
# Если модель не найдена — берётся первая модель первого облачного провайдера
# (в лог уходит WARN).
LLM_ROUTER_FALLBACK_MODEL=gpt-4o-mini

# === Web Search (v0.10 S1; v0.15 S3 — Tavily/Bing/Brave) ===
# Провайдер поиска по умолчанию для узла web_search: tavily | bing | brave.
# Узел может переопределить его полем data.provider (если ключей несколько).
WEB_SEARCH_PROVIDER=tavily
# API-ключ Tavily (https://tavily.com, формат tvly-...). Без ключа приложение
# поднимается, но isConfigured=false, а вызов поиска падает понятной ошибкой.
TAVILY_API_KEY=
# Ключ Bing Web Search API v7 (Azure, https://portal.azure.com). Без ключа
# провайдер bing недоступен и не предлагается в UI.
BING_API_KEY=
# Ключ Brave Search API (https://brave.com/search/api/). Без ключа провайдер
# brave недоступен и не предлагается в UI.
BRAVE_API_KEY=

# === Redis (BullMQ queue for workflow runs) ===
# 127.0.0.1, не localhost: иначе Node может уйти в IPv6 ::1 (RULES 4.31).
REDIS_URL=redis://127.0.0.1:6379

# === BullMQ worker (KI-065, KI-032) ===
# Число одновременных заданий очереди workflow-runs (1-50).
WORKFLOW_RUNS_CONCURRENCY=5
# Удержание lock'а job'а в мс; должен быть больше самого долгого узла.
WORKFLOW_RUNS_LOCK_DURATION_MS=300000
# Переотдач при истечении lock'а до пометки failed.
WORKFLOW_RUNS_MAX_STALLED_COUNT=2
# Порог «зависшего» запуска (lease, KI-023) в мс.
WORKFLOW_RUNS_STALE_THRESHOLD_MS=300000
# Push о завершении запуска (v1.5.0 S5-B, KI-659). false — не отправлять push
# ни при каком исходе; true — отправлять (см. следующий флаг).
PUSH_ON_RUN_COMPLETE=true
# Отправлять push и при успешном завершении. false — только про падение,
# чтобы каждый успешный запуск не спамил пользователя.
PUSH_ON_RUN_COMPLETE_SUCCESS=false

# === Изоляция очередей BullMQ между инстансами (R7.2b, KI-387) ===
# Проблема: несколько backend-ов (dev + smoke + prod) на одном Redis делят
# очередь, и задание, созданное в dev, может выполнить боевой воркер с платным
# ключом. При параллельной работе задайте КАЖДОМУ инстансу уникальный префикс
# и/или отдельную БД Redis:
#   dev:   BULLMQ_PREFIX=workflow-runs-dev   REDIS_QUEUE_DB=1
#   smoke: BULLMQ_PREFIX=workflow-runs-smoke REDIS_QUEUE_DB=2
#   prod:  BULLMQ_PREFIX=workflow-runs       REDIS_QUEUE_DB=0
# Префикс — пространство ключей Redis (по умолчанию у BullMQ был `bull`).
# REDIS_QUEUE_DB перекрывает номер БД из пути `/N` в REDIS_URL.
BULLMQ_PREFIX=workflow-runs
REDIS_QUEUE_DB=0
# Идентификатор инстанса (маркер в payload задания). Пусто = стабильный
# hostname:PORT — задание переживает рестарт процесса (KI-391). Задавайте явно
# для параллельных инстансов и в среде с эфемерным hostname (Docker/K8s):
# воркер пропускает задания чужого instanceId (второй рубеж после префикса/БД).
INSTANCE_ID=

# === Бюджет запуска (R7.1, KI-048) ===
# Предохранитель по стоимости: проверяется ПЕРЕД платным вызовом провайдера
# (LLM, image_generation, image_tool, video/audio/music_generation). Стоимость
# считается по запуску (node_runs.cost_usd + cost_rub), поэтому job-retry не
# сбрасывает траты.
# Лимит запуска в USD (LLM-узлы).
WORKFLOW_RUN_MAX_COST_USD=5
# Лимит запуска в рублях (media-узлы: CreativeLab тарифицирует в рублях).
WORKFLOW_RUN_MAX_COST_RUB=500
# hard — превышение блокирует вызов (узел failed), soft — только предупреждение.
WORKFLOW_RUN_BUDGET_MODE=hard
# Курс RUB→USD для нормализации лимитов в одну шкалу (сколько рублей в долларе).
WORKFLOW_RUN_USD_RUB_RATE=100

# === WASM-песочница (R7.5, KI-364) ===
# Режим `sandbox` узла condition исполняет пользовательский JS в QuickJS-WASM
# (изолированный realm, без process/require/fetch). По умолчанию ВЫКЛЮЧЕН:
# включите осознанно. При false узел с mode=sandbox падает с ошибкой
# «Sandbox disabled in env», режим DSL работает всегда.
SANDBOX_ENABLED=false
# Таймаут вычисления, мс (1..5000). При превышении VM уничтожается,
# узел падает с «Timeout exceeded».
SANDBOX_TIMEOUT_MS=100
# Лимит памяти песочницы, МБ (1..256). При превышении — «Memory limit exceeded».
SANDBOX_MEMORY_MB=16

# === Agent-узел (R7.4b, DESIGN v0.9 § 3.4) ===
# Лимит итераций цикла LLM → tool → … → final по умолчанию (1..10).
# Узел может переопределить его полем maxIterations; при исчерпании узел
# падает AgentIterationLimitException (запуск не висит).
AGENT_MAX_ITERATIONS_DEFAULT=5
# Лимит токенов ответа на одну итерацию (1..8192). Каждый шаг — платный вызов.
AGENT_MAX_TOKENS_PER_STEP_DEFAULT=2048

# === Сетевая безопасность (v0.11 S14, KI-434/435/478) ===
# SSRF-защита исходящих HTTP-запросов: `SafeHttpClient` резолвит DNS один раз,
# проверяет все адреса, прибивает IP (rebinding) и вручную обходит редиректы.
# `http_request` агента приватные адреса блокирует ВСЕГДА; узел `http` можно
# разрешить отдельным флагом HTTP_NODE_ALLOW_PRIVATE_NETWORKS (ниже).
# Прежний ALLOW_PRIVATE_IPS удалён в v0.11 (он отключал защиту и у агента).

# === Auth (R6.1a) ===
JWT_SECRET=dev-secret-change-me-at-least-32-chars
JWT_EXPIRES_IN=24h
# Отключить auth в dev/CI (запросы под system@workflow-builder.local):
AUTH_DISABLED=false

# === Auth (refresh) ===
# Срок жизни refresh-токена (opaque, httpOnly cookie). Формат: <N><s|m|h|d>.
JWT_REFRESH_EXPIRES_IN=7d
# Secure-cookie (true в prod, false в dev/CI).
COOKIE_SECURE=false

# === Observability: OpenTelemetry (R7.7, KI-365) ===
# Трассировка выключена по умолчанию: SDK подменяет глобальный провайдер и
# держит фоновый экспортёр. Включайте, когда есть коллектор/Jaeger.
OTEL_ENABLED=false
# Базовый URL OTLP/HTTP-коллектора; трейсы уходят на <endpoint>/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Имя сервиса в телеметрии (атрибут service.name).
OTEL_SERVICE_NAME=workflow-builder

# === Метрики: allowlist для GET /metrics (v1.6.0 S6-A, KI-575) ===
# Prometheus не умеет JWT, поэтому ручка закрыта по IP (guard отвечает 403).
# Формат — через запятую: точные адреса и IPv4-CIDR. Дефолт — только loopback.
# Prometheus в Docker ходит из подсети compose: добавьте её (например
# 172.18.0.0/16), иначе scrape получит 403. Внешний скрейпер — по точному IP.
METRICS_ALLOWED_IPS=127.0.0.1,::1

# === Vector (v0.10 S0, KI-455) ===
# Аварийный выключатель vector/memory-узлов. default true — текущее поведение
# (pgvector уже работает). false — узлы `vector_upsert`/`vector_query`/
# `memory_read`/`memory_write` падают понятной ошибкой конфигурации, не
# пытаясь обращаться к pgvector. Разбор строгий: значение 'false' — это false.
PGVECTOR_ENABLED=true

# === Лимиты одновременных вызовов на провайдера LLM (R7.7, KI-067) ===
# Глобальный concurrency воркера не разделяет провайдеров. Лимит ограничивает
# число ОДНОВРЕМЕННЫХ вызовов провайдера; лишние ждут в очереди семафора.
# Пусто/не задано — без ограничения (прежнее поведение). Значения 1..1000.
LLM_PROVIDER_MAX_CONCURRENCY_ANTHROPIC=
LLM_PROVIDER_MAX_CONCURRENCY_OPENAI=
LLM_PROVIDER_MAX_CONCURRENCY_ROUTERAI=
LLM_PROVIDER_MAX_CONCURRENCY_DEEPSEEK=
LLM_PROVIDER_MAX_CONCURRENCY_YANDEX=
LLM_PROVIDER_MAX_CONCURRENCY_LMSTUDIO=
LLM_PROVIDER_MAX_CONCURRENCY_GPTUNNEL=
# Для провайдера вне списка лимит читается динамически:
# LLM_PROVIDER_MAX_CONCURRENCY_<NAME> (NAME — имя провайдера в верхнем регистре).

# === Хранилище media-результатов (R7.8, KI-362) ===
# Ссылки CreativeLab живут 48 ч; local скачивает результат сразу после
# генерации и раздаёт через GET /media/file/:runId/:fileName.
# local | s3 | none. s3 без ключей ниже откатывается на local (KI-412).
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_LOCAL_PATH=./data/media
# TTL локальных ссылок, дни (0 — без срока). Раз в сутки cron удаляет файлы
# старше TTL (KI-413).
MEDIA_STORAGE_LOCAL_TTL_DAYS=30
# HMAC-подпись локальных media-ссылок (KI-415): /media/file/...?expires=&sign=.
# Не задано — берётся JWT_SECRET (ссылки всё равно подписаны); отдельный секрет
# позволяет ротировать подписи независимо от авторизации. Минимум 16 символов.
MEDIA_URL_SIGNING_SECRET=
# Время жизни подписанной ссылки, секунды (KI-415). Снимок перевыпускает её по
# storage_key (KI-464), поэтому час — безопасный дефолт.
MEDIA_URL_TTL_SECONDS=3600
# TTL файлов workspace ./data/workspace/<workflowId>/ (KI-413), дни.
# 0 — очистка workspace выключена.
WORKSPACE_TTL_DAYS=30
# S3-совместимое хранилище (AWS S3 / MinIO / R2 / Yandex Object Storage).
# Заполняется только при MEDIA_STORAGE_BACKEND=s3: нужны endpoint, бакет и
# обе ключевые пары, иначе бэкенд не активируется.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_TTL_DAYS=30
# Публичный ли бакет (KI-444). true — прямой URL объекта; false — presigned
# GET на час (для приватного бакета; ссылка переподписывается на чтении).
# Не задано — false: безопасный дефолт, прямой URL приватного бакета даёт 403.
S3_PUBLIC_BUCKET=false

# === Document templates (v0.11) ===
# Загрузка .docx-шаблонов для режима template узла document_gen.
# Предохранители: 5 МБ архива, 50 МБ распакованного (ZIP-бомба), 2000 записей,
# 50 шаблонов на workflow, 256 КБ JSON-переменных. Используются загрузчиком
# шаблонов (v0.11 S2 — валидация/рендер, S3 — multer/CRUD).
DOCUMENT_TEMPLATE_MAX_BYTES=5242880
DOCUMENT_TEMPLATE_MAX_UNCOMPRESSED_BYTES=52428800
DOCUMENT_TEMPLATE_MAX_ENTRIES=2000
DOCUMENT_TEMPLATE_MAX_PER_WORKFLOW=50
DOCUMENT_TEMPLATE_MAX_VARIABLES_BYTES=262144

# === MCP (v0.11, stdio — v0.12 S4) — выключен по умолчанию ===
# MCP_ENABLED=false: зависимость не ходит в сеть и не открывает внешние
# инструменты без явного решения администратора. Разбор строгий: значение
# 'false' — это false. MCP_SERVERS — JSON-реестр серверов; в примере — пустой
# объект. URL, заголовки и токены серверов задаются только здесь, из графа их
# задать нельзя (SSRF, DESIGN § 3.2.8).
#
# MCP_ENABLE_STDIO=false (v0.12 S4, KI-526): отдельный выключатель запуска
# ЛОКАЛЬНЫХ процессов MCP-серверов. При true в MCP_SERVERS разрешён транспорт
# stdio — {"filesystem":{"transport":"stdio","command":"docker","args":["run","-i","--rm","mcp/filesystem","/data"]}}.
# Это потенциальный RCE: включайте только на доверенной инсталляции, аргументы
# передаются массивом (без shell), а команды-оболочки (sh -c, cmd /c) и
# разрушительные утилиты (rm, mkfs, format, ...) отвергаются на старте.
MCP_ENABLED=false
MCP_ENABLE_STDIO=false
# MCP_STDIO_ENV_ALLOWLIST (v0.13 S1, KI-529): имена env-переменных через
# запятую, которые разрешено передать stdio-процессу. Значения берутся из
# окружения backend'а или из per-server "env" в MCP_SERVERS; всё остальное
# (включая секреты backend'а) в процесс НЕ попадает. Пусто — ни одной.
MCP_STDIO_ENV_ALLOWLIST=
# MCP_STDIO_CWD (v0.13 S1, KI-530): базовый каталог изоляции; для каждого
# сервера создаётся <MCP_STDIO_CWD>/<server> и передаётся как cwd.
MCP_STDIO_CWD=./data/mcp
MCP_SERVERS={}
MCP_CONNECT_TIMEOUT_MS=10000
MCP_REQUEST_TIMEOUT_MS=30000
MCP_CATALOG_TTL_MS=60000
MCP_MAX_TOOLS_PER_SERVER=200
MCP_MAX_TOOLS_PER_NODE=20
MCP_MAX_RESULT_CHARS=4000

# === Run lease / heartbeat (KI-066) ===
# Heartbeat продлевает аренду запуска, чтобы падение worker'а обнаруживалось
# за TTL, а не за 5 минут. TTL обязан быть не меньше 2 × heartbeat — иначе
# один пропущенный тик «убивает» живой запуск (проверяется на старте).
WORKFLOW_RUN_HEARTBEAT_MS=30000
WORKFLOW_RUN_LEASE_TTL_MS=90000

# === Retry (KI-104) ===
# Повторы только retryable-ошибок (429/5xx/timeout). 1 попытка — без повторов
# (аварийный откат поведения). Пауза: base × 2^attempt, но не больше max,
# плюс случайный джиттер 0..jitter.
NODE_RETRY_MAX_ATTEMPTS=3
NODE_RETRY_BASE_DELAY_MS=500
NODE_RETRY_MAX_DELAY_MS=10000
NODE_RETRY_JITTER_MS=250

# === SSRF (KI-434/435/478) ===
# Отдельный флаг для узла `http`: true разрешает приватные сети (только для
# доверенного self-hosted). Инструмент агента http_request этим флагом НЕ
# отключается — он всегда блокирует приватные адреса (DESIGN § 3.5.1).
# Metadata-алиасы (169.254.169.254, metadata.google.internal) остаются
# запрещёнными и при true. Разбор строгий: значение 'false' — это false.
HTTP_NODE_ALLOW_PRIVATE_NETWORKS=false

# === Throttler (KI-420) ===
# redis — общие счётчики rate limit между инстансами (default). memory —
# откат к прежнему поведению (для локальной разработки без Redis-кластера).
THROTTLER_STORAGE=redis
THROTTLER_KEY_PREFIX=throttle:v1


# === SMTP (v1.1.0 S1, DESIGN V110 § 3.1) ===
# Письма-приглашения в организацию. Все переменные опциональны: без SMTP_HOST
# приглашение создаётся в БД, письмо не отправляется, сервис пишет WARN
# (fallback). SMTP_SECURE разбирается строго: 'true' — implicit TLS (465),
# 'false' — STARTTLS (587). APP_PUBLIC_URL — публичный адрес приложения для
# абсолютной ссылки в письме (по умолчанию http://localhost:3000).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@workflow-builder.local
SMTP_SECURE=false
APP_PUBLIC_URL=http://localhost:3000

# === RuStore Push (S4-B, миграция FCM → RuStore Push) ===
# Отправка push через RuStore API (POST
# https://vkpns.rustore.ru/v1/projects/<projectId>/messages:send).
# Обе переменные опциональны: без них приложение поднимается, регистрация
# токенов устройств работает, а отправка пишет WARN и возвращает 0 доставленных
# (fallback). Пустое значение = «не задано» (KI-084).
# Project ID из консоли RuStore — НЕ секрет: попадает в URL запроса.
RUSTORE_PROJECT_ID=
# Сервисный токен RuStore — СЕКРЕТ: только .env / secret manager, в логи и
# сообщения ошибок не попадает (RULES 5.1, 5.3). Уходит в заголовке
# Authorization: Bearer <token>.
RUSTORE_SERVICE_TOKEN=
